<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, system CAs only (user-installed CAs are not trusted, so a
     device-level MITM proxy cannot read or alter model downloads). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
