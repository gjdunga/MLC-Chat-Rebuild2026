diff --git a/cmake/modules/Logging.cmake b/cmake/modules/Logging.cmake
index 09bb094..9f36ed6 100644
--- a/cmake/modules/Logging.cmake
+++ b/cmake/modules/Logging.cmake
@@ -20,10 +20,12 @@
 include(FindPackageHandleStandardArgs)
 
 if(USE_CUSTOM_LOGGING)
-  # Set and propagate TVM_LOG_CUSTOMIZE flag is custom logging has been requested
-  target_compile_definitions(tvm_objs PUBLIC TVM_LOG_CUSTOMIZE=1)
-  target_compile_definitions(tvm_runtime_objs PUBLIC TVM_LOG_CUSTOMIZE=1)
-  target_compile_definitions(tvm_libinfo_objs PUBLIC TVM_LOG_CUSTOMIZE=1)
-  target_compile_definitions(tvm_compiler PUBLIC TVM_LOG_CUSTOMIZE=1)
-  target_compile_definitions(tvm_runtime PUBLIC TVM_LOG_CUSTOMIZE=1)
+  # Set and propagate TVM_LOG_CUSTOMIZE flag is custom logging has been requested.
+  # Only touch targets that exist: tvm_libinfo_objs was removed from the build,
+  # and the configure step failed for every custom-logging (Android) build.
+  foreach(_tvm_log_target tvm_objs tvm_runtime_objs tvm_libinfo_objs tvm_compiler tvm_runtime)
+    if(TARGET ${_tvm_log_target})
+      target_compile_definitions(${_tvm_log_target} PUBLIC TVM_LOG_CUSTOMIZE=1)
+    endif()
+  endforeach()
 endif()
